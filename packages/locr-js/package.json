{
  "name": "locr",
  "version": "0.1.0",
  "description": "Local OCR for Node.js, Bun, Deno and browsers. Pure Rust engine compiled to WebAssembly: no cloud APIs, no downloads at runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KevRojo/locr.git",
    "directory": "packages/locr-js"
  },
  "type": "module",
  "main": "./dist/node.cjs",
  "module": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./locr_bg.wasm": "./dist/locr_bg.wasm"
  },
  "files": [
    "dist",
    "NOTICE-MODELS"
  ],
  "sideEffects": false,
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsup",
    "test": "node --test test/locr.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ocr",
    "local",
    "offline",
    "wasm",
    "webassembly",
    "rust",
    "image-to-text",
    "text-recognition"
  ]
}
